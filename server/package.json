{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run cf-typegen && wrangler secret bulk .dev.vars && wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "better-auth-gen-schema": "npx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/lib/schema.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.2.5",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.11.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.0",
    "wrangler": "^4.4.0"
  }
}
