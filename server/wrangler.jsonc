{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat"],

  // Default = dev
  "vars": {
    "CLIENT_URL": "http://localhost:3000",
    "ENVIRONMENT": "dev"
  },

  "env": {
    "production": {
      "vars": {
        "CLIENT_URL": "https://quiz-app-glug-client.vercel.app",
        "ENVIRONMENT": "prod"
      }
    }
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
