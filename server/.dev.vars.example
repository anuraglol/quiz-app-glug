# Database - Neon PostgreSQL connection string
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret for verifying tokens from Next.js API routes
# Must match JWT_SECRET in client/.env.local
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
